{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "files": [
    "src/lib/payments/payment-types.ts",
    "src/lib/payments/gateway-config.ts",
    "src/lib/payments/fedapay.service.ts",
    "src/lib/payments/dons-webhook.ts",
    "src/app/api/dons/initier/route.ts",
    "src/app/api/dons/fedapay/confirmation/route.ts",
    "src/app/admin/api/paiements/route.ts",
    "src/components/admin/paiements-client.tsx",
    "src/components/site/contribuer-view.tsx",
    "src/lib/tiktok-miniature.ts",
    "src/app/api/tiktok/backfill/route.ts",
    "src/app/api/cron/backfill-miniatures-tiktok/route.ts",
    "src/app/admin/api/[entity]/route.ts",
    "src/app/admin/api/[entity]/[id]/route.ts",
    "src/components/admin/videos-tabs-client.tsx"
  ]
}
