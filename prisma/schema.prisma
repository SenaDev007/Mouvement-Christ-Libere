// Prisma schema — Christ Libère
// PostgreSQL pour compatibilité Vercel (serverless incompatible SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// MODÈLES — V1 MVP + préparation V2
// ============================================================

// --- Utilisateurs & rôles ---

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          UserRole  @default(MEMBER)
  avatarUrl     String?
  bio           String?
  country       String?
  city          String?
  // ⭐ V2.7 — « Informations complètes » du profil membre/viewer
  phone         String?
  // ⭐ V2.9 — Présence (heartbeat du client → « N en ligne » dans Yeshua
  // Connect, sans Socket.io : la valeur est rafraîchie toutes les ~25 s par
  // POST /api/yeshua-connect/presence et lue par les conversations).
  lastSeenAt    DateTime?
  isVerified    Boolean   @default(false)
  isMinor       Boolean   @default(false)
  acceptedTerms DateTime
  // ⭐ V2.0 — NextAuth fields
  emailVerified DateTime?
  image         String?
  // ⭐ V2.0 — Push notifications (Web Push API)
  pushSubscription String?  @db.Text  // JSON: { endpoint, keys: { p256dh, auth } }
  pushEnabled   Boolean   @default(true)
  // ⭐ V2.0 — Notification preferences
  notifMessages Boolean   @default(true)
  notifAnnouncements Boolean @default(true)
  notifLive     Boolean   @default(true)
  notifCommunity Boolean  @default(true)
  // ⭐ V2.0 — DND (Do Not Disturb)
  dndEnabled    Boolean   @default(false)
  dndUntil      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages      Message[]
  callsInitiated Call[]    @relation("CallInitiator")
  callsReceived  Call[]    @relation("CallRecipient")
  channelMembers ChannelMember[]
  communityMembers CommunityMember[]
  // ⭐ V3.5 — Blocage entre membres (sécurité des conversations privées)
  blocksInitiated UserBlock[] @relation("UserBlockBlocker")
  blocksReceived  UserBlock[] @relation("UserBlockBlocked")
  testimonies   Testimony[] @relation("TestimonyAuthor")
  contactRequests ContactRequest[]
  bibleBookmarks BibleBookmark[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([country])
}

enum UserRole {
  SUPER_ADMIN     // PAM, Pasteur Kongo
  ADMIN           // Délégués
  MODERATOR       // Bénévoles modération
  ANIMATOR        // Animateurs de canaux
  MEMBER_VERIFIED // Croyant authentifié
  MEMBER          // Inscrit de base
  GUEST           // Visiteur (généralement pas en DB)
}

// --- Serviteurs ---

model Servant {
  id          String   @id @default(cuid())
  code        String   @unique // "pam" | "kongo"
  fullName    String
  shortName   String
  role        String
  bio         String
  portraitUrl String?
  isActive    Boolean  @default(true)
  // ⭐ V3.3 — Localisation du serviteur : alimente la carte des dispersés
  // (renseignée depuis le back-office /admin/servants).
  pays        String? // code ISO 2 lettres : "CI", "FR", "IL"…
  ville       String? // "Abidjan", "Paris"… (affiché sous le nom)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  biographies Biography[]
  testimonies Testimony[]
  teachings   Teaching[]
  videos      Video[]
  liveStreams LiveStream[]
  streamConfig ServantStreamConfig?
}

// --- Biographies (frise chronologique) ---

model Biography {
  id          String   @id @default(cuid())
  servantId   String
  date        String   // "Enfance", "2024-03", etc.
  title       String
  description String
  verseRef    String?
  verseText   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  servant     Servant  @relation(fields: [servantId], references: [id], onDelete: Cascade)

  @@index([servantId])
}

// --- Témoignages ---

model Testimony {
  id          String   @id @default(cuid())
  servantId   String
  authorId    String?
  title       String
  short       String
  content     String   @db.Text
  status      TestimonyStatus @default(TO_DISCERN)
  themes      String[] // tags
  bookRef     String?
  readingTime String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  servant     Servant  @relation(fields: [servantId], references: [id])
  author      User?    @relation("TestimonyAuthor", fields: [authorId], references: [id])

  @@index([servantId])
  @@index([status])
  @@index([publishedAt])
}

enum TestimonyStatus {
  TO_DISCERN
  CONFIRMED
  ARCHIVED
}

// --- Enseignements ---

model Teaching {
  id          String   @id @default(cuid())
  servantId   String
  title       String
  excerpt     String
  content     String   @db.Text
  theme       String
  book        String
  level       TeachingLevel
  readingTime String?
  pdfUrl      String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  servant     Servant  @relation(fields: [servantId], references: [id])
  liturgicalEvents LiturgicalEvent[]

  @@index([servantId])
  @@index([theme])
  @@index([level])
  @@index([publishedAt])
}

enum TeachingLevel {
  DECOUVERTE
  INTERMEDIAIRE
  AVANCE
}

// --- Vidéos & Lives ---

model Video {
  id          String   @id @default(cuid())
  servantId   String
  title       String
  description String   @db.Text
  duration    String
  thumbnailUrl String?
  videoUrl    String?
  hlsUrl      String?
  views       Int      @default(0)
  isLive      Boolean  @default(false)
  publishedAt DateTime?
  // ─── Post-production cloud sync ───
  // Stocke l'état complet du projet (timeline, overlays, filtres, etc.)
  // en JSON pour permettre la sauvegarde/chargement et le partage.
  projectState Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ⭐ V2.9 — Upload chunked (contourne la limite 4,5 Mo de Vercel) :
  // chunks temporaires + blob assemblé servi par /api/videos/:id/stream.
  uploadChunks VideoChunk[]
  uploadBlob   VideoBlob?

  servant     Servant  @relation(fields: [servantId], references: [id])

  @@index([servantId])
  @@index([isLive])
  @@index([publishedAt])
}

// ⭐ V2.9 — Morceaux d'upload vidéo (transfert par blocs ≤ 3,5 Mo).
// Chaque POST /api/videos/:id/chunk?index=N écrit un morceau ;
// POST /api/videos/:id/chunk/complete les assemble dans VideoBlob puis
// purge cette table. Vérrou de concurrence : le champ data peut être
// volumineux, on ne le sélectionne JAMAIS dans les listes.
model VideoChunk {
  id      String  @id @default(cuid())
  videoId String
  idx     Int
  data    Bytes
  createdAt DateTime @default(now())

  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, idx])
}

// ⭐ V2.9 — Blob vidéo assemblé, servi en streaming (avec Range HTTP)
// par /api/videos/:id/stream — Video.videoUrl pointe vers cette route.
model VideoBlob {
  videoId  String   @id
  data     Bytes
  mime     String   @default("video/mp4")
  size     Int
  createdAt DateTime @default(now())

  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model LiveStream {
  id           String    @id @default(cuid())
  servantId    String
  title        String
  description  String    @db.Text
  scheduledAt  DateTime
  startedAt    DateTime?
  endedAt      DateTime?
  rtmpUrl      String?
  hlsUrl       String?
  status       LiveStatus @default(SCHEDULED)
  youtubeUrl   String?
  facebookUrl  String?
  tiktokUrl    String?
  instagramUrl    String?
  // ─── V2.0 — LiveKit + multistreaming ───
  livekitRoomName  String?
  multistreamEnabled Boolean @default(false)
  streamToYoutube   Boolean  @default(false)
  streamToFacebook  Boolean  @default(false)
  streamToTiktok    Boolean  @default(false)
  streamToInstagram    Boolean  @default(false)
  recordingUrl      String?
  viewerCount       Int      @default(0)
  thumbnailUrl      String?
  // ─── Pause live ( YouTube viewers ne reçoivent pas le DataChannel LiveKit ) ───
  // isPaused = true pendant que le studio met le live en pause.
  // pausedAt permet aux viewers YouTube de geler la minuterie côté client
  // (calculée = pausedAt - startedAt).
  isPaused          Boolean  @default(false)
  pausedAt          DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  servant      Servant   @relation(fields: [servantId], references: [id])
  chatMessages LiveChatMessage[]
  viewers      LiveViewer[]

  @@index([servantId])
  @@index([status])
  @@index([scheduledAt])
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

// Messages et réactions du chat live (façon YouTube)
model LiveChatMessage {
  id          String   @id @default(cuid())
  liveId      String
  userId      String?
  userName    String
  content     String
  type        String   @default("message") // "message" | "reaction"
  emoji       String?  // pour les réactions: "❤️", "👍", "🔥", etc.
  likeCount   Int      @default(0)
  createdAt   DateTime @default(now())

  live        LiveStream @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@index([liveId, createdAt])
  @@index([type])
}

// Membre inscrit sur la plateforme (inscription unique pour tous les lives)
model LiveMember {
  id          String   @id @default(cuid())
  sessionId   String   @unique // identifiant unique par navigateur (localStorage)
  firstName   String
  lastName    String?
  country     String?
  city        String?
  contact     String?
  totalXp     Int      @default(0)
  livesWatched Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  liveViewers LiveViewer[]
  disperses   DisperseMember[]

  @@index([contact])
}

// Sessions de visionnage (un membre qui regarde un live spécifique)
model LiveViewer {
  id          String   @id @default(cuid())
  liveId      String
  memberId    String
  xpPoints    Int      @default(0) // XP gagné pendant CE live
  isActive    Boolean  @default(true)
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  // ⭐ V2.9 — Fraîcheur de présence : heartbeat du viewer (toutes les ~25 s).
  // Le compteur GET ne compte que les sessions vues il y a < 90 s → un
  // onglet fermé sans beacon de départ n'influe plus indéfiniment.
  lastSeenAt  DateTime @default(now())

  live        LiveStream  @relation(fields: [liveId], references: [id], onDelete: Cascade)
  member      LiveMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([liveId, isActive])
  @@index([memberId])
}

// Configuration des clés RTMP par serviteur (YouTube, Facebook, TikTok, Instagram)
model ServantStreamConfig {
  id              String   @id @default(cuid())
  servantId       String   @unique
  youtubeRtmpUrl  String?
  youtubeRtmpKey  String?
  facebookRtmpUrl String?
  facebookRtmpKey String?
  tiktokRtmpUrl   String?
  tiktokRtmpKey   String?
  instagramRtmpUrl   String?
  instagramRtmpKey   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  servant         Servant  @relation(fields: [servantId], references: [id])
}

// --- Média social intégré ---

model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  isPublic    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels    Channel[]
  members     CommunityMember[]

  @@index([isPublic])
}

model CommunityMember {
  id           String      @id @default(cuid())
  communityId  String
  userId       String
  role         ChannelRole @default(MEMBER)
  joinedAt     DateTime    @default(now())

  community    Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model Channel {
  id           String       @id @default(cuid())
  communityId  String
  name         String
  description  String?
  // ⭐ V2.5 — Photo du canal/groupe (data URL compressée ≤ 80KB ou URL R2),
  // modifiable depuis le back-office, affichée dans Yeshua Connect.
  avatarUrl    String?
  // ⭐ V2.7 — Mode vidéo des canaux vocaux (bascule façon WhatsApp, décidée
  // par l'administrateur : quand videoMode = true, tous les participants
  // connectés publient leur caméra et voient la grille vidéo ; false = audio).
  videoMode    Boolean     @default(false)
  type         ChannelType
  isEncrypted  Boolean      @default(false)
  isRestricted Boolean      @default(false)
  // ⭐ V3.20 — Conversation PRIVÉE 1-1 (créée via POST /conversations/dm) :
  // visible et lisible UNIQUEMENT par ses 2 membres — pas même les admins
  // (directive : « un message privé entre deux membres ne devrait même pas
  // être vu par les admins »). Posé par la route /dm, rétro-fixé par
  // ensureChannelIsDirectColumn() via les AuditLog DM_CREATE existants.
  isDirect     Boolean      @default(false)
  order        Int          @default(0)
  lastMessageAt DateTime?   // ⭐ V2.1 — date du dernier message (tri des canaux)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  community    Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages     Message[]
  members      ChannelMember[]
  scheduledMessages ScheduledMessage[]

  @@index([communityId])
  @@index([type])
}

enum ChannelType {
  TEXT
  VOICE
  VIDEO
  ANNOUNCEMENT
  RESTRICTED
}

model ChannelMember {
  id         String      @id @default(cuid())
  channelId  String
  userId     String
  role       ChannelRole @default(MEMBER)
  joinedAt   DateTime    @default(now())
  lastReadAt DateTime?

  channel    Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

enum ChannelRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  ANIMATOR
  MEMBER
}

model Message {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  content    String    @db.Text
  type       MessageType @default(TEXT)
  attachmentUrl String?
  isEncrypted Boolean   @default(false)
  replyToId  String?
  isEdited   Boolean   @default(false)
  isDeleted  Boolean   @default(false)
  // ⭐ V2.1 — Épinglage des messages
  isPinned   Boolean   @default(false)
  pinnedAt   DateTime?
  pinnedBy   String?
  // ⭐ V2.1 — Métadonnées des pièces jointes (audio, image, fichier)
  attachmentName String?
  attachmentSize Int?
  attachmentMime String?
  duration   Float?   // durée audio/vidéo en secondes
  // ⭐ V2.1 — Verset biblique partagé
  verseRef   String?
  verseText  String?
  // ⭐ V2.1 — Historique d'édition (anciens contenus + timestamps)
  editedHistory Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions  MessageReaction[]
  poll       Poll?

  @@index([channelId, createdAt])
  @@index([userId])
  @@index([isPinned])
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
  FILE
  POLL
  SCHEDULED
  VERSE
  ANNOUNCEMENT
  GIF
  CALL_LOG
  MEMBER_LOG
}

// ⭐ V2.4 — Sondages (polls) dans Yeshua Connect
model Poll {
  id          String   @id @default(cuid())
  messageId   String   @unique
  question    String
  isMulti     Boolean  @default(false)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options     PollOption[]
}

model PollOption {
  id          String   @id @default(cuid())
  pollId      String
  label       String
  order       Int      @default(0)
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes       PollVote[]
  @@index([pollId])
}

model PollVote {
  id          String   @id @default(cuid())
  pollOptionId String
  userId      String
  createdAt   DateTime @default(now())
  option      PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  @@unique([pollOptionId, userId])
  @@index([pollOptionId, userId])
}

// ⭐ V2.4 — Messages programmés
model ScheduledMessage {
  id          String    @id @default(cuid())
  channelId   String
  userId      String
  content     String    @db.Text
  scheduledAt DateTime
  status      ScheduledMessageStatus @default(PENDING)
  sentMessageId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  @@index([scheduledAt, status])
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

// ⭐ V2.1 — Réactions emoji persistées sur les messages
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// --- Appels audio/vidéo ---

model Call {
  id           String    @id @default(cuid())
  initiatorId  String
  recipientId  String
  type         CallType
  status       CallStatus @default(MISSED)
  startedAt    DateTime?
  endedAt      DateTime?
  duration     Int? // en secondes
  isUrgent     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  initiator    User      @relation("CallInitiator", fields: [initiatorId], references: [id])
  recipient    User      @relation("CallRecipient", fields: [recipientId], references: [id])

  @@index([recipientId, status])
  @@index([initiatorId])
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  MISSED
  ANSWERED
  REJECTED
  IN_PROGRESS
}

// --- Demandes de contact ---

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  contact   String   // email ou WhatsApp
  message   String   @db.Text
  userId    String?
  status    ContactStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id])

  @@index([status])
}

enum ContactStatus {
  PENDING
  ANSWERED
  ARCHIVED
}

// --- Dons ---

model Donation {
  id        String   @id @default(cuid())
  amount    Float
  currency  String   @default("EUR")
  method    String   // card, transfer, mobile_money, crypto
  donorName String?
  donorEmail String?
  donorUserId String?
  message   String?
  isAnonymous Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// --- Calendrier liturgique (V2) ---

model LiturgicalEvent {
  id          String   @id @default(cuid())
  name        String   // "Pessah", "Shavouot", etc.
  nameFr      String   // "Pâque"
  nameHe      String?  // "פֶּסַח"
  type        LiturgicalEventType
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime?
  teachingId  String?  // enseignement lié
  color       String   @default("#C9A227") // or par défaut
  isShabbat   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teaching    Teaching? @relation(fields: [teachingId], references: [id])

  @@index([startDate])
  @@index([type])
}

enum LiturgicalEventType {
  SPRING_FEAST     // Pâque, Pain sans levain, Prémices, Pentecôte
  FALL_FEAST       // Trompettes, Expiation, Tabernacles
  SHABBAT          // Sabbat hebdomadaire
  NEW_MOON         // Roch 'Hodech
  OTHER            // Pourim, Hanoucca, etc.
}

// Préférences utilisateur pour notifications calendrier
model UserCalendarPreference {
  id              String   @id @default(cuid())
  userId          String
  shabbatRest     Boolean  @default(false) // suspendre notifications pendant shabbat
  feastReminders  Boolean  @default(true)
  reminderDays    Int      @default(1) // jours avant l'événement
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId])
}

// --- Carte des dispersés d'Israël (V3) ---

model DisperseMember {
  id            String   @id @default(cuid())
  liveMemberId  String?  // lien vers LiveMember (inscription unique)
  // ⭐ V3.12 — Lien direct vers le compte User officiel : les positions
  // créées par /register (ou /disperses/add connecté) portent l'id du
  // membre — la purge V3.12 conserve TOUJOURS ces entrées.
  userId        String?
  pseudonyme    String   // nom ou pseudo, pas de vrai nom
  pays          String   // code ISO 2 lettres (FR, CI, US, etc.)
  ville         String?
  latitude      Float    // arrondi à 0.1° pour anonymat
  longitude     Float    // arrondi à 0.1° pour anonymat
  langue        String   // FR, EN, ES, PT, HE, AM, etc.
  niveau        String   @default("chercheur") // chercheur, croyant, disciple, pasteur
  message       String?  @db.Text // témoignage court optionnel
  isPublic      Boolean  @default(true)
  // ⭐ V3.14 — Entrée restaurée/gérée manuellement (ex. Akpovi Sènakpon,
  // rétabli après la purge V3.12 à la demande du pasteur) : la purge ne
  // peut JAMAIS supprimer une entrée manuelle.
  manuel        Boolean  @default(false)
  createdAt     DateTime @default(now())

  liveMember    LiveMember? @relation(fields: [liveMemberId], references: [id], onDelete: SetNull)

  @@index([pays])
  @@index([langue])
  @@index([liveMemberId])
}

// --- Chaîne d'intercession (V4) ---

model IntercessionRequest {
  id          String   @id @default(cuid())
  auteur      String   // pseudonyme
  sujet       String   // court résumé
  description String   @db.Text
  categorie   String   @default("general") // sante, famille, spiritual, urgence, action_graces
  isUrgent    Boolean  @default(false)
  isPublic    Boolean  @default(true)
  statut      String   @default("ouvert") // ouvert, en_priere, exauce, archive
  temoignageExaucement String? @db.Text
  prayCount   Int      @default(0) // nombre de personnes qui ont prié
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([statut])
  @@index([categorie])
  @@index([isUrgent])
}

// --- Dead man's switch (V4) ---

model DeadMansSwitch {
  id              String   @id @default(cuid())
  contenuId       String   // ID du contenu à publier
  contenuType     String   // temoignage, enseignement, video
  contenuTitre    String
  contenuData     String   @db.Text // contenu sérialisé
  hash            String   // SHA-256 du contenu
  delaiJours      Int      @default(30) // jours sans activité avant publication
  derniereActivite DateTime @default(now())
  estDeclenche    Boolean  @default(false)
  dateDeclenchement DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([estDeclenche])
}

// --- ⭐ V2.3 — Audit Log (modération) ---

// ⭐ V3.5 — Blocage entre membres (sécurité des PRIVÉS, comme Telegram /
// WhatsApp) : bloquer un membre l'empêche de vous écrire en privé ET de
// vous appeler (et réciproquement). Les canaux communs restent ouverts —
// on bloque la personne, pas la communauté.
model UserBlock {
  id         String   @id @default(cuid())
  blockerId  String   // qui bloque
  blockedId  String   // qui est bloqué
  createdAt  DateTime @default(now())

  blocker    User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // "MESSAGE_DELETE", "MESSAGE_EDIT", "MESSAGE_PIN", "USER_JOIN", "USER_LEAVE", "CHANNEL_CREATE", etc.
  userId    String
  targetId  String?  // ID de la cible (message, canal, etc.)
  channelId String?
  metadata  Json?    // détails supplémentaires (ancien contenu, nouveau contenu, etc.)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([userId])
}

// --- Bible bookmarks (V3) ---

model BibleBookmark {
  id          String   @id @default(cuid())
  userId      String
  version     String   // ex: "fr-apee", "en-kjv"
  livreId     String   // ex: "gn", "mt"
  livreNom    String   // ex: "Genèse", "Matthieu"
  chapitre    Int
  verset      Int
  texte       String   @db.Text // texte du verset
  note        String?  @db.Text // note personnelle (optionnel)
  couleur     String?  // couleur de marque-page (optionnel)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version, livreId, chapitre, verset])
  @@index([userId])
}
