{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "files": [
    "src/lib/payments/payment-types.ts",
    "src/lib/payments/gateway-config.ts",
    "src/app/admin/api/paiements/route.ts",
    "src/app/admin/paiements/page.tsx",
    "src/components/admin/paiements-client.tsx",
    "src/components/pwa/instructions-installation.tsx",
    "src/components/pwa/install-app-button.tsx",
    "src/components/pwa/install-toast.tsx",
    "src/components/ui/navigation-menu-4.tsx",
    "src/components/ui/modem-animated-footer.tsx",
    "src/components/admin/admin-shell.tsx",
    "src/app/layout.tsx",
    "src/components/site/layout-shell.tsx"
  ]
}
