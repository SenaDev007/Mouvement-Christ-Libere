{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "files": [
    "src/proxy.ts",
    "src/lib/staff-space/annonces-api.ts",
    "src/lib/staff-space/session.ts",
    "src/app/secretariat/api/annonces/route.ts",
    "src/app/secretariat/api/annonces/[id]/route.ts",
    "src/app/admin/api/annonces/route.ts",
    "src/app/admin/api/annonces/[id]/route.ts",
    "src/app/secretariat/annonces/page.tsx",
    "src/app/admin/annonces/page.tsx",
    "src/components/staff-space/annonces-view.tsx",
    "src/components/admin/admin-shell.tsx"
  ]
}
