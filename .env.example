# ══════════════════════════════════════════════════════════════════════
# Mouvement Christ Libère — Variables d'environnement
# ══════════════════════════════════════════════════════════════════════
# À configurer sur VERCEL (Settings → Environment Variables).
# ⚠️ AUCUNE de ces clés ne doit jamais être commise ni exposée au
# navigateur — elles ne vivent que côté serveur.
#
# ⭐ V3.82 — section PAIEMENTS (page /contribuer) en tête : c'est la
# configuration à poser pour activer les dons en ligne.
# ⭐ V3.83 — LES CLÉS PEUVENT DÉSORMAIS ÊTRE CONFIGURÉES DEPUIS LE
# BACK-OFFICE (admin.mouvementchristlibere.com → Passerelles de paiement,
# super admins uniquement) : elles y sont chiffrées (AES-256-GCM) et
# PRIMENT sur ces variables. Tout ce qui suit reste le REPLI valable
# (aucune configuration back-office → variables serveur utilisées).
# ══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# ① PAIEMENTS — DONS EN LIGNE (V3.82 — repli ; V3.83 : back-office)
# ──────────────────────────────────────────────────────────────────────

# ⭐ V3.83 — Clé maîtresse du CHIFFREMENT des secrets configurés depuis
# le back-office (/admin/paiements). RECOMMANDÉE : une longue chaîne
# aléatoire (ex. openssl rand -hex 32). Si absente, SESSION_SECRET est
# utilisée ; sans aucune des deux, le stockage n'est qu'obfusqué.
PAYMENTS_MASTER_KEY=""

# URL publique du site (callbacks de retour + liens des emails).
# Renseignée telle quelle en production :
SITE_URL="https://www.mouvementchristlibere.com"

# ── FEDAPAY — canal local : Côte d'Ivoire / Afrique de l'Ouest ──
# Mobile Money (MTN, Orange, Moov, Wave) + cartes bancaires régionales.
# Dashboard : https://fedapay.com
#
# Clé secrète API : sk_live_... en production, sk_sandbox_... pour tester.
FEDAPAY_SECRET_KEY=""
# ⭐ V3.85 — Clé PUBLIQUE (pk_live_... / pk_sandbox_...) : avec elle, le
# paiement s'ouvre dans un widget DIRECTEMENT sur la page /contribuer (le
# donateur ne quitte plus le site — modèle éprouvé). Sans elle, redirection
# vers la plateforme FedaPay (mode historique). Configurable aussi depuis
# le back-office → Passerelles de paiement.
FEDAPAY_PUBLIC_KEY=""
# Environnement : "sandbox" pour les tests, "live" en production.
FEDAPAY_ENV="live"
# Secret des webhooks (Dashboard FedaPay → Développeurs → Webhooks).
# ⚠️ OBLIGATOIRE en production : sans lui, les webhooks sont rejetés.
FEDAPAY_WEBHOOK_SECRET=""
# (Optionnel) Surcharger l'API FedaPay — inutile en temps normal.
# FEDAPAY_API_BASE="https://api.fedapay.com"
#
# Webhook à déclarer dans le dashboard FedaPay :
#   https://www.mouvementchristlibere.com/api/webhooks/fedapay
# Signature : HMAC-SHA256 du corps brut avec FEDAPAY_WEBHOOK_SECRET
# (en-tête X-FEDAPAY-SIGNATURE).

# ── PAYSTACK — canal international : Visa / Mastercard (monde entier) ──
# Règlement en FCFA (XOF).
# Dashboard : https://dashboard.paystack.com
#
# Clé secrète : sk_live_... en production, sk_test_... pour tester.
PAYSTACK_SECRET_KEY=""
# Secret du HMAC des webhooks (en-tête x-paystack-signature).
# Par convention = PAYSTACK_SECRET_KEY (laisser vide pour l'automatique).
PAYSTACK_WEBHOOK_SECRET=""
#
# Webhook à déclarer dans le dashboard Paystack :
#   https://www.mouvementchristlibere.com/api/webhooks/paystack
# Signature : HMAC-SHA512 du corps brut avec PAYSTACK_SECRET_KEY.

# ──────────────────────────────────────────────────────────────────────
# ② BASE DE DONNÉES (PostgreSQL — Neon)
# ──────────────────────────────────────────────────────────────────────
DATABASE_URL=""

# ──────────────────────────────────────────────────────────────────────
# ③ EMAILS TRANSACTIONNELS (Resend)
# ──────────────────────────────────────────────────────────────────────
# Option A (direct) : clé posée sur Vercel → envoi direct.
# Option B (relais — choix actuel) : clé posée sur le backend Railway
# (api.mouvementchristlibere.com) → l'envoi y est relayé automatiquement.
RESEND_API_KEY=""
EMAIL_EXPEDITEUR="Mouvement Christ Libère <noreply@mouvementchristlibere.com>"
# URL du backend relais (si l'option B est utilisée).
BACKEND_URL="https://api.mouvementchristlibere.com"
# Secret partagé Vercel ↔ Railway pour durcir le relais (optionnel).
EMAIL_SERVICE_SECRET=""

# ──────────────────────────────────────────────────────────────────────
# ④ AUTHENTIFICATION
# ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""
# Session de l'espace trésoriers (back-office financier).
SESSION_SECRET=""
# (Développement uniquement) Mot de passe des comptes de démonstration.
ADMIN_DEFAULT_PASSWORD=""

# ──────────────────────────────────────────────────────────────────────
# ⑤ STOCKAGE R2 (Cloudflare — vidéos, uploads)
# ──────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ──────────────────────────────────────────────────────────────────────
# ⑥ LIVE & STREAMING (LiveKit, YouTube, Daily)
# ──────────────────────────────────────────────────────────────────────
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL=""
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
DAILY_API_KEY=""

# ──────────────────────────────────────────────────────────────────────
# ⑦ NOTIFICATIONS PUSH (Web Push — Yeshua Connect)
# ──────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# ──────────────────────────────────────────────────────────────────────
# ⑧ SERVITEURS (emails réels des destinataires — optionnels, le
#    paramétrage du secrétariat prime)
# ──────────────────────────────────────────────────────────────────────
EMAIL_KONGO=""
EMAIL_AFRIKA=""
