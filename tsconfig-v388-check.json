{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "files": [
    "src/lib/staff-space/devises.ts",
    "src/lib/staff-space/constants.ts",
    "src/app/tresorerie/api/stats/route.ts",
    "src/app/tresorerie/api/transactions/route.ts",
    "src/app/tresorerie/api/donateurs/route.ts",
    "src/app/tresorerie/api/caisses/route.ts",
    "src/app/tresorerie/api/rapports/route.ts",
    "src/app/tresorerie/dashboard/page.tsx",
    "src/app/tresorerie/transactions/page.tsx",
    "src/app/tresorerie/donateurs/page.tsx",
    "src/app/tresorerie/caisse/page.tsx",
    "src/app/tresorerie/rapports/page.tsx",
    "src/app/tresorerie/layout.tsx"
  ]
}
